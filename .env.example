# ── ConsentGrid environment ─────────────────────────────────────────────
# Backend select. Production = Postgres. Local dev/CI = built-in SQLite.
#   postgres://user:pass@host:5432/consentgrid   (production)
#   sqlite://./data/consentgrid.db               (local file)
#   sqlite://:memory:                            (tests)
DATABASE_URL=sqlite://./data/consentgrid.db

# HTTP
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# ── Key management ──────────────────────────────────────────────────────
# KMS_PROVIDER: local | aws
#   local  -> LocalDevSigner. Keys in ./data/keys (DEV ONLY, never prod).
#   aws    -> AWS KMS asymmetric ECC_NIST_P256 signing key (prod path).
KMS_PROVIDER=local
KMS_LOCAL_DIR=./data/keys
# For KMS_PROVIDER=aws (India region):
AWS_REGION=ap-south-1
KMS_SIGNING_KEY_ARN=

# ── Server-side secret pepper for identifier HMAC (see SECURITY.md) ──────
# The keyed identifier hash is HMAC-SHA256(key = perUserSalt || SERVER_HMAC_PEPPER, msg = user_token).
# The pepper is a global server secret; the salt is per-user and Fiduciary-held.
# In production this pepper itself lives in the KMS/secrets manager, not here.
SERVER_HMAC_PEPPER=dev-pepper-change-me

# Webhook signing secret (per-endpoint secrets override this default)
WEBHOOK_SIGNING_SECRET=dev-webhook-secret-change-me

# Dashboard session cookie signing secret. If unset, falls back to
# WEBHOOK_SIGNING_SECRET. Set a distinct value in production.
SESSION_SECRET=dev-session-secret-change-me

# Rate limiting (token bucket)
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
